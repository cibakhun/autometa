# Local Postgres (docker compose up -d) or a Supabase connection string.
# On Vercel use Supabase's pooled connection string (port 6543).
DATABASE_URL=postgres://autometa:autometa@localhost:5432/autometa

# Optional: separate connection for migrations. Needed when DATABASE_URL points to a
# transaction pooler (Supabase port 6543); use the direct or session-mode string (port 5432).
# MIGRATION_DATABASE_URL=

# Optional: number of generated demo listings (default 3000).
# DEMO_LISTING_COUNT=3000

# Scraping (see README, "Eine neue Quelle anbinden").
# Honest bot name; add a contact URL once the site is live, e.g. "AutoMetaBot/0.1 (+https://…/bot)".
# SCRAPE_USER_AGENT=AutoMetaBot/0.1
# Follow each portal's robots.txt (default true).
# SCRAPE_RESPECT_ROBOTS=true
# Pause between two requests to the same portal, at least 1000 ms (default 5000).
# SCRAPE_MIN_DELAY_MS=5000
# Most requests per import run (default 500).
# SCRAPE_MAX_REQUESTS=500

# Sources the background worker imports, comma-separated (autoscout24, kleinanzeigen, mobilede).
# Unset: no worker, the site shows the demo data.
# SCRAPE_SOURCES=autoscout24,kleinanzeigen
# Minutes between two import rounds, at least 10 (default 60).
# SCRAPE_INTERVAL_MINUTES=60
# Limit the makes read per portal, as slugs (default: all makes of the taxonomy).
# AUTOSCOUT24_MAKES=volkswagen,bmw
# KLEINANZEIGEN_MAKES=volkswagen,bmw
# MOBILE_DE_MAKES=volkswagen,bmw

# mobile.de, only through its official Search-API with an API account from mobile.de.
# Without these two the mobilede source does not run. Keep them secret.
# MOBILE_DE_API_USER=
# MOBILE_DE_API_PASSWORD=
# Pause between two API requests, at least 200 ms (default 1000), and requests per run (default 1000, at least 40).
# MOBILE_DE_MIN_DELAY_MS=1000
# MOBILE_DE_MAX_REQUESTS=1000

# Admin pages (/admin/quellen?token=...): source status and test fetches from the server.
# At least 16 characters; unset, every /admin URL answers 404.
# ADMIN_TOKEN=
