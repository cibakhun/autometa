# Local Postgres (docker compose up -d) or a Supabase connection string.
# On Vercel use Supabase's pooled connection string (port 6543).
DATABASE_URL=postgres://autometa:autometa@localhost:5432/autometa

# Optional: separate connection for migrations. Needed when DATABASE_URL points to a
# transaction pooler (Supabase port 6543); use the direct or session-mode string (port 5432).
# MIGRATION_DATABASE_URL=

# Optional: number of generated demo listings (default 3000).
# DEMO_LISTING_COUNT=3000
