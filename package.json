{
  "name": "autometa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx scripts/migrate.ts && tsx scripts/prepare.ts && next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:prepare": "tsx scripts/prepare.ts",
    "ingest": "tsx scripts/ingest.ts",
    "db:setup": "npm run db:migrate && npm run db:prepare"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
